{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solar Forge Diagrams",
  "version": "0.1.0",
  "identifier": "com.solarforge.diagrams",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Solar Forge Diagrams", "width": 1440, "height": 960, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
