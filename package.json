{
  "name": "solar-forge-diagrams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run check && vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:size": "bun scripts/check-budgets.ts",
    "verify": "bun run lint && bun run check && bun test && bun run build && bun run check:size"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "three": "0.183.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "1.3.11",
    "@types/three": "0.183.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
